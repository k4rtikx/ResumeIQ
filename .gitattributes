# Exclude large marketing/landing page templates (not the core app logic)
initial/templates/main.html linguist-detectable=false
initial/templates/pricing.html linguist-detectable=false
initial/templates/feature.html linguist-detectable=false
initial/templates/works.html linguist-detectable=false

