# GitHub Linguist — ResumeIQ language configuration
# Strategy: exclude all HTML, then re-enable only 3 key functional templates

# Step 1: Exclude ALL HTML
*.html linguist-detectable=false

# Step 2: Re-enable only the most important app templates (small, functional)
templates/base.html                                        linguist-detectable=true
initial/templates/analyzer.html                            linguist-detectable=true
users/templates/registration/password_reset_form.html      linguist-detectable=true
