# Copy this file -> rename to .env -> fill in your real values
# The real .env is gitignored and will NEVER be pushed to GitHub

# Django
DJANGO_SECRET_KEY=your-django-secret-key-here

# Database (local Docker setup)
DB_NAME=resume_analyzer
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=db
DB_PORT=5432

# External PostgreSQL (Neon/Render) - if set, takes priority
DATABASE_URL=

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Groq (free LLM fallback)
GROQ_API_KEY=your-groq-api-key

# Gmail SMTP
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# Razorpay (payments)
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
